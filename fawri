    function sanitizeEmail(email) {
      return email.replace(/[.#$\/\[\]]/g, "_");
    }

    window.addEventListener('DOMContentLoaded', () => {
      history.replaceState({ view: 'home' }, '', '');

      try {
        const savedUser = localStorage.getItem('fori_current_user');
        if (savedUser) {
          const localUser = JSON.parse(savedUser);
          db.ref(`users/${sanitizeEmail(localUser.email)}`).once('value').then((snapshot) => {
            const remoteUser = snapshot.val();
            if (remoteUser) {
              currentUser = remoteUser;
            } else {
              currentUser = localUser;
              if (currentUser.points === undefined) currentUser.points = 0;
              if (!currentUser.vouchers) currentUser.vouchers = [];
              if (!currentUser.orders) currentUser.orders = [];
              saveUserToDatabase();
            }
            try { localStorage.setItem('fori_current_user', JSON.stringify(currentUser)); } catch(e){}
            updateAuthUI();
            renderInlinePreviousOrders();
          }).catch(() => {});
        } else {
          document.getElementById('auth-modal').classList.remove('hidden');

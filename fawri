    function handleAuthSubmit() {
      const email = document.getElementById('auth-email').value.trim();
      const password = document.getElementById('auth-password').value.trim();
      const name = document.getElementById('auth-name').value.trim();
      const errEl = document.getElementById('auth-error');

      if (!email || !password) { errEl.textContent = 'الرجاء إدخال البريد وكلمة المرور'; errEl.classList.remove('hidden'); return; }
      if (isRegisterMode && !name) { errEl.textContent = 'الرجاء إدخال الاسم الكامل'; errEl.classList.remove('hidden'); return; }

      const userKey = sanitizeEmail(email);
      db.ref(`users/${userKey}`).once('value').then((snapshot) => {
        let existingUser = snapshot.val();

        if (isRegisterMode) {
          if (existingUser) { errEl.textContent = 'البريد مستخدم مسبقاً!'; errEl.classList.remove('hidden'); return; }
          currentUser = { name, email, password, points: 0, vouchers: [], orders: [] };
          db.ref(`users/${userKey}`).set(currentUser);
        } else {
          if (!existingUser || existingUser.password !== password) { errEl.textContent = 'البريد أو كلمة المرور غير صحيحة!'; errEl.classList.remove('hidden'); return; }
          currentUser = existingUser;
          if (currentUser.points === undefined) currentUser.points = 0;
          if (!currentUser.vouchers) currentUser.vouchers = [];
          if (!currentUser.orders) currentUser.orders = [];
        }

        try { localStorage.setItem('fori_current_user', JSON.stringify(currentUser)); } catch(e){}
        document.getElementById('auth-modal').classList.add('hidden');
        updateAuthUI();
        renderInlinePreviousOrders();
      }).catch(() => {
        errEl.textContent = 'حدث خطأ في الاتصال بقاعدة البيانات';
        errEl.classList.remove('hidden');
      });
    }


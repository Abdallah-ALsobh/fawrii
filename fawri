    function renderMenuGrid() {
      const grid = document.getElementById('menu-grid');
      if (!grid || !currentStoreKey) return;
      grid.innerHTML = '';
      const store = storesData[currentStoreKey];
      const catData = store.menu[currentCategory];
      if (!catData || !catData.items) return;
      const flash = store.flashSale && store.flashSale.active ? store.flashSale : null;

      catData.items.forEach((item) => {
        let displayPrice = item.price;
        let isDiscounted = false;
        if (flash && flash.targetItemIds && flash.targetItemIds.includes(String(item.id))) {
          displayPrice = item.price * (1 - flash.discount / 100);
          isDiscounted = true;
        }

        const article = document.createElement('article');
        article.className = 'menu-card p-4 flex flex-col ' + (!item.available ? 'opacity-60 bg-gray-100' : '');
        let priceHtml = `<span class="font-extrabold text-lg text-[#881337]">${displayPrice.toFixed(2)} د.أ</span>`;
        if (isDiscounted) {
          priceHtml = `<div class="flex items-center gap-2 flex-wrap"><span class="font-extrabold text-lg text-[#881337]">${displayPrice.toFixed(2)} د.أ</span><span class="text-xs text-gray-400 line-through font-bold">${item.price.toFixed(2)} د.أ</span><span class="text-xs font-extrabold px-1.5 py-0.5 rounded" style="background:#ffe4e6; color:#881337;">خصم ${flash.discount}%</span></div>`;
        }

        article.innerHTML = `<img src="${item.image}" class="w-full h-40 object-cover mb-3 border border-gray-100 rounded-2xl"><div class="flex flex-col flex-1"><h3 class="font-extrabold text-base mb-1 text-[#18181b]">${item.name}</h3><p class="text-xs text-gray-600 flex-1 mb-3 font-medium">${item.desc}</p><div class="flex items-center justify-between mt-auto pt-2.5 border-t border-gray-100">${priceHtml}${item.available ? '<button type="button" class="add-to-order-btn font-extrabold text-xs px-4 py-2 rounded-2xl shadow-sm"><i class="fa-solid fa-cart-plus ml-1"></i> إضافة +</button>' : '<span class="text-xs font-bold text-red-600 bg-red-100 px-2.5 py-1 rounded-xl">نفدت الكمية</span>'}</div></div>`;
        if (item.available) article.querySelector('.add-to-order-btn').addEventListener('click', () => openModal(item, displayPrice));
        grid.appendChild(article);
      });
    }

    function openModal(item, effectivePrice) {
      currentModalItem = { ...item, price: effectivePrice };
      currentModalQty = 1;
      document.getElementById('modal-item-name').textContent = item.name;
      document.getElementById('modal-item-desc').textContent = item.desc;
      document.getElementById('modal-base-price').textContent = `${effectivePrice.toFixed(2)} د.أ`;
      document.getElementById('modal-qty').textContent = '1';
      updateModalTotal();
      document.getElementById('customization-modal').classList.remove('hidden');
    }
    function closeModal() { document.getElementById('customization-modal').classList.add('hidden'); currentModalItem = null; }
    function changeModalQty(d) { currentModalQty = Math.max(1, currentModalQty + d); document.getElementById('modal-qty').textContent = currentModalQty; updateModalTotal(); }
    function updateModalTotal() { if (currentModalItem) document.getElementById('modal-total').textContent = `${(currentModalItem.price * currentModalQty).toFixed(2)} د.أ`; }

    function confirmAddToOrder() {
      if (!currentModalItem) return;
      const existing = cart.find(c => c.itemId === currentModalItem.id);
      if (existing) existing.qty += currentModalQty;
      else cart.push({ itemId: currentModalItem.id, name: currentModalItem.name, basePrice: currentModalItem.price, qty: currentModalQty });
      closeModal();
      renderCart();
    }

    function renderCart() {
      const container = document.getElementById('order-items-container');
      container.innerHTML = '';
      if (cart.length === 0) {
        container.innerHTML = '<p id="empty-order" class="text-center py-8 text-gray-400 text-xs italic font-bold">سلة المشتريات فارغة</p>';
        appliedVoucher = null;
      } else {
        cart.forEach((cartItem, index) => {
          const itemDiv = document.createElement('div');
          itemDiv.className = 'flex items-center justify-between gap-2.5 py-2.5 border-b border-gray-100 text-xs';
          itemDiv.innerHTML = `<div class="flex-1 min-w-0"><p class="font-extrabold truncate text-gray-900">${cartItem.name}</p><span class="text-gray-500 font-bold">${(cartItem.basePrice * cartItem.qty).toFixed(2)} د.أ</span></div><div class="flex items-center gap-1.5 shrink-0"><button type="button" class="qty-btn qty-minus w-7 h-7 text-xs">−</button><span class="font-extrabold w-5 text-center">${cartItem.qty}</span><button type="button" class="qty-btn qty-plus w-7 h-7 text-xs">+</button></div><button type="button" class="remove-btn p-1.5 text-red-500 shrink-0 hover:bg-red-50 rounded-lg"><i class="fa-solid fa-trash-can"></i></button>`;
          itemDiv.querySelector('.qty-minus').addEventListener('click', () => updateCartQty(index, -1));
          itemDiv.querySelector('.qty-plus').addEventListener('click', () => updateCartQty(index, 1));
          itemDiv.querySelector('.remove-btn').addEventListener('click', () => removeCartItem(index));
          container.appendChild(itemDiv);
        });
      }

      let subtotal = cart.reduce((sum, item) => sum + (item.basePrice * item.qty), 0);
      
      if (appliedVoucher) {
        let discountVal = appliedVoucher.discountValue;
        const minRequiredSpend = discountVal * 6;

        if (subtotal < minRequiredSpend) {
          alert(`⚠️ تم إلغاء القسيمة (${appliedVoucher.code}) لأن مجموع المشتريات أصبح أقل من الحد الأدنى المطلوب.`);
          appliedVoucher = null;
        } else {
          document.getElementById('applied-voucher-banner').style.display = 'flex';
          document.getElementById('applied-voucher-code-text').textContent = `${appliedVoucher.code} (${discountVal.toFixed(2)} د.أ)`;
          document.getElementById('discount-display-row').style.display = 'flex';
          document.getElementById('discount-amount-text').textContent = `-${discountVal.toFixed(2)} د.أ`;
          subtotal -= discountVal;
        }
      }
      
      if (!appliedVoucher) {
        document.getElementById('applied-voucher-banner').style.display = 'none';
        document.getElementById('discount-display-row').style.display = 'none';
      }

      document.getElementById('order-subtotal').textContent = `${subtotal.toFixed(2)} د.أ`;
      document.getElementById('order-count').textContent = cart.reduce((sum, item) => sum + item.qty, 0);
    }

    function updateCartQty(index, d) {
      if (!cart[index]) return;
      cart[index].qty += d;
      if (cart[index].qty <= 0) cart.splice(index, 1);
      renderCart();
    }
    function removeCartItem(index) { cart.splice(index, 1); renderCart(); }

    function toggleOrderPanel() {
      if (window.innerWidth < 1024) {
        const panel = document.getElementById('order-panel-fixed');
        const isOpen = panel.classList.toggle('panel-open');
        document.getElementById('panel-toggle-btn').textContent = isOpen ? 'إغلاق السلة' : 'عرض السلة';
      }
    }

    function submitOrder() {
      if (cart.length === 0) { alert('سلة المشتريات فارغة!'); return; }
      document.getElementById('order-customer-name').value = currentUser && currentUser.name ? currentUser.name : '';
      document.getElementById('phone-input').value = '';
      document.getElementById('address-input').value = '';
      document.getElementById('location-status').innerHTML = '⚠️ لم يتم تحديد الموقع بدقة بعد';
      customerLocationUrl = '';
      document.getElementById('name-error').classList.add('hidden');
      document.getElementById('name-modal').classList.remove('hidden');
    }
    function closeNameModal() { document.getElementById('name-modal').classList.add('hidden'); }

    function confirmNameAndSubmit() {
      const custName = document.getElementById('order-customer-name').value.trim();
      const phone = document.getElementById('phone-input').value.trim();
      const address = document.getElementById('address-input').value.trim();
      const paymentMethod = "الدفع نقداً عند الاستلام (COD)";
      const errEl = document.getElementById('name-error');
      
      if (!custName) { errEl.textContent = 'أدخل اسم الزبون'; errEl.classList.remove('hidden'); return; }
      if (!phone) { errEl.textContent = 'أدخل رقم الهاتف'; errEl.classList.remove('hidden'); return; }
      if (!address) { errEl.textContent = 'أدخل العنوان'; errEl.classList.remove('hidden'); return; }
      if (!customerLocationUrl) { errEl.textContent = 'يجب تحديد الموقع (GPS) بدقة أولاً!'; errEl.classList.remove('hidden'); return; }

      closeNameModal();

      const store = storesData[currentStoreKey];
      const rawSubtotal = cart.reduce((s, i) => s + (i.basePrice * i.qty), 0);
      let discountVal = appliedVoucher ? appliedVoucher.discountValue : 0;
      const finalTotal = Math.max(0, rawSubtotal - discountVal);
      
      const uniqueOrderId = 'ord_' + Date.now();
      const sequentialOrderId = `#${Math.floor(Math.random() * 900 + 100)}`;

      const earnedPoints = Number((finalTotal * 0.25).toFixed(2));
      if (currentUser) {
        currentUser.points = Number(((currentUser.points || 0) + earnedPoints).toFixed(2));
        if (appliedVoucher) {
          currentUser.vouchers = currentUser.vouchers.filter(v => v.code !== appliedVoucher.code);
        }
        if (!currentUser.orders) currentUser.orders = [];
      }

      const orderRecord = {
        storeKey: currentStoreKey,
        storeName: store.name,
        orderId: sequentialOrderId,
        customerName: custName,
        phone: phone,
        address: address,
        paymentMethod: paymentMethod,
        date: new Date().toLocaleString('ar-JO'),
        finalTotal: finalTotal,
        captinStatus: 'pending',
        captainName: '',
        captainPhone: '',
        captainLat: null,
        captainLng: null,
        items: cart.map(i => ({ ...i }))
      };

      db.ref(`orders/${currentStoreKey}/${uniqueOrderId}`).set(orderRecord);
      db.ref(`captainOffers/${currentStoreKey}/${uniqueOrderId}`).set(orderRecord)
        .then(() => {
          executeLeaveStore();
          document.getElementById('stores-view').classList.remove('hidden');
          const trackingSection = document.getElementById('live-order-tracking-section');
          if (trackingSection) {
            trackingSection.classList.remove('hidden');
            trackingSection.scrollIntoView({ behavior: 'smooth' });
          }
        });

      if (currentUser) {
        currentUser.orders.push(orderRecord);
        saveUserToDatabase();
        updateAuthUI();
      }

      let msg = `*طلب جديد إلى متجر: ${store.name}* 🚀\n`;
      msg += `📌 رقم الطلب: ${sequentialOrderId}\n\n`;
      msg += `👤 *معلومات الزبون:*\n`;
      msg += `- الاسم: ${custName}\n`;
      msg += `- الهاتف: ${phone}\n`;
      msg += `- العنوان: ${address}\n`;
      msg += `- 💳 طريقة الدفع: *${paymentMethod}*\n`;
      msg += `- 📍 رابط خريطة الموقع (GPS): ${customerLocationUrl}\n\n`;
      msg += `🛒 *قائمة المشتريات والأسعار:*\n`;

      cart.forEach((item, idx) => {
        msg += `${idx + 1}. ${item.name} x${item.qty} - السعر الإجمالي: ${(item.basePrice * item.qty).toFixed(2)} د.أ\n`;
      });
      
      if (appliedVoucher) msg += `\n🎟️ تم استخدام قسيمة خصم (${appliedVoucher.code}): -${discountVal.toFixed(2)} د.أ`;
      msg += `\n💰 *المجموع النهائي: ${finalTotal.toFixed(2)} د.أ*`;

      window.open(`https://wa.me/${store.whatsapp}?text=${encodeURIComponent(msg)}`, '_blank');

      cart = [];
      appliedVoucher = null;
      renderCart();
      renderInlinePreviousOrders();
    }

    function updateCustomerMap(lat, lng, captainName) {
      const mapContainer = document.getElementById('customer-captain-map');
      if (!mapContainer) return;

      if (!customerLiveMap) {
        customerLiveMap = L.map('customer-captain-map').setView([lat, lng], 15);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '© OpenStreetMap'
        }).addTo(customerLiveMap);

        captainLiveMarker = L.marker([lat, lng]).addTo(customerLiveMap)
          .bindPopup(`🛵 الكابتن: ${captainName}`)
          .openPopup();
      } else {
        const newLatLng = new L.LatLng(lat, lng);
        captainLiveMarker.setLatLng(newLatLng);
        customerLiveMap.panTo(newLatLng);
        setTimeout(() => { customerLiveMap.invalidateSize(); }, 200);
      }
    }

    function startGlobalOrderTrackingListener() {
      db.ref('orders').on('value', (snapshot) => {
        const storesObj = snapshot.val();
        const trackingSection = document.getElementById('live-order-tracking-section');
        
        if (!storesObj) {
          if (trackingSection) trackingSection.classList.add('hidden');
          return;
        }

        let latestOrder = null;
        let latestDbKey = null;

        Object.keys(storesObj).forEach(storeKey => {
          const storeOrders = storesObj[storeKey];
          if (storeOrders) {
            Object.keys(storeOrders).forEach(dbKey => {
              const ord = storeOrders[dbKey];
              if (ord && typeof ord === 'object') {
                if (!latestDbKey || dbKey > latestDbKey) {
                  latestDbKey = dbKey;
                  latestOrder = ord;
                }
              }
            });
          }
        });

        if (latestOrder) {
          if (latestOrder.captinStatus === 'completed') {
            if (trackingSection) trackingSection.classList.add('hidden');
            return;
          }

          if (trackingSection) trackingSection.classList.remove('hidden');

          document.getElementById('tracking-store-info').textContent = `الطلب (${latestOrder.orderId}) من منشأة: ${latestOrder.storeName} | المجموع: ${latestOrder.finalTotal.toFixed(2)} د.أ`;

          const headline = document.getElementById('tracking-status-headline');
          const desc = document.getElementById('tracking-status-desc');
          const box = document.getElementById('tracking-status-box');
          const icon = document.getElementById('tracking-status-icon');
          const captainBox = document.getElementById('captain-info-box');
          const captainNameEl = document.getElementById('tracking-captain-name');
          const captainPhoneContainer = document.getElementById('captain-phone-container');
          const mapWrapper = document.getElementById('customer-live-map-wrapper');

          if (latestOrder.captinStatus === 'pending') {
            icon.innerHTML = '<i class="fa-solid fa-clock-rotate-left"></i>';
            headline.textContent = 'جاري البحث عن كابتن لتوصيل طلبك...';
            desc.textContent = `طلبك من (${latestOrder.storeName}) بانتظار قبول الكابتن.`;
            box.className = 'p-5 rounded-2xl border-2 border-dashed border-amber-400 bg-amber-50 space-y-3';
            captainBox.classList.add('hidden');
            if (mapWrapper) mapWrapper.classList.add('hidden');
          } 
          else if (latestOrder.captinStatus === 'accepted' || latestOrder.captinStatus === 'picked_up') {
            const isPickedUp = latestOrder.captinStatus === 'picked_up';
            icon.innerHTML = isPickedUp ? '<i class="fa-solid fa-box-open"></i>' : '<i class="fa-solid fa-motorcycle"></i>';
            headline.textContent = isPickedUp ? 'استلم الكابتن طلبك وهو في طريقه إليك الآن!' : 'وافق الكابتن على الطلب ومتوجه للمطعم!';
            desc.textContent = isPickedUp ? `العنوان: ${latestOrder.address}. يرجى تجهيز مبلغ الدفع (${latestOrder.finalTotal.toFixed(2)} د.أ).` : `يقوم الكابتن باستلام طلبك الساخن وتجهيزه للتوصيل.`;
            box.className = isPickedUp ? 'p-5 rounded-2xl border-2 border-emerald-400 bg-emerald-50 space-y-3' : 'p-5 rounded-2xl border-2 border-blue-400 bg-blue-50 space-y-3';
            
            if (latestOrder.captainName) {
              captainNameEl.textContent = latestOrder.captainName;
              captainPhoneContainer.innerHTML = latestOrder.captainPhone ? `<a href="tel:${latestOrder.captainPhone}" class="${isPickedUp ? 'bg-emerald-600 hover:bg-emerald-700' : 'bg-blue-600 hover:bg-blue-700'} text-white px-3 py-1.5 rounded-xl font-extrabold text-[11px] shadow"><i class="fa-solid fa-phone ml-1"></i> اتصال بالكابتن</a>` : '';
              captainBox.classList.remove('hidden');
            }

            if (mapWrapper) {
              mapWrapper.classList.remove('hidden');
              const lat = latestOrder.captainLat || 31.9539;
              const lng = latestOrder.captainLng || 35.9106;
              setTimeout(() => {
                updateCustomerMap(lat, lng, latestOrder.captainName || 'الكابتن');
              }, 250);
            }
          }
        } else {
          if (trackingSection) trackingSection.classList.add('hidden');
        }
      });
    }
  </script>
</body>

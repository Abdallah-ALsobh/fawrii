    let customerLocationUrl = '';
    function getMandatoryLocation() {
      const statusEl = document.getElementById('location-status');
      if (!navigator.geolocation) { 
        statusEl.innerHTML = '❌ متصفحك لا يدعم تحديد الموقع (GPS)'; 
        return; 
      }
      
      statusEl.innerHTML = '⏳ جاري التقاط الأقمار الصناعية وتحسين دقة الموقع...';
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const lat = pos.coords.latitude;
          const lng = pos.coords.longitude;
          const accuracy = pos.coords.accuracy;
          customerLocationUrl = `https://maps.google.com/?q=${lat},${lng}`;
          statusEl.innerHTML = `✅ تم التقاط موقعك بدقة عالية (نسبة الخطأ ~${Math.round(accuracy)} متر)!`;
        },
        (error) => {
          let errorMsg = '❌ فشل تحديد الموقع.';
          if (error.code === error.PERMISSION_DENIED) {
            errorMsg = '❌ تم رفض إذن الوصول للموقع. يرجى السماح للمتصفح من الإعدادات.';
          } else if (error.code === error.POSITION_UNAVAILABLE) {
            errorMsg = '❌ إشارة الـ GPS غير متوفرة.';
          } else if (error.code === error.TIMEOUT) {
            errorMsg = '❌ انتهت مهلة البحث عن الموقع.';
          }
          statusEl.innerHTML = errorMsg;
          customerLocationUrl = '';
        },
        { enableHighAccuracy: true, timeout: 20000, maximumAge: 0 }
      );
    }


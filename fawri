      const val = snapshot.val();
      if (val) {
        storesData = val;
        if (currentStoreKey) renderMenuGrid();
      }
      rebuildCombinedOffersList();
      dismissSplashScreen();
    }, (error) => {
      console.warn("Firebase storesData warning:", error);
      dismissSplashScreen();
    });

    db.ref('homeAds').on('value', (snapshot) => {
      homeAdsData = snapshot.val() || {};
      rebuildCombinedOffersList();
      dismissSplashScreen();
    }, (error) => {
      console.warn("Firebase homeAds warning:", error);
      dismissSplashScreen();
    });

    let combinedOffersList = [];

    function rebuildCombinedOffersList() {
      combinedOffersList = [];

      Object.keys(homeAdsData).forEach(adKey => {
        const ad = homeAdsData[adKey];
        if (ad && ad.title) {
          let storeNameText = '';
          if (ad.storeKey && storesData[ad.storeKey]) {
            storeNameText = `🏪 ${storesData[ad.storeKey].name}`;
          } else {
            const catNames = { restaurants: '🍔 قسم المطاعم والمشويات', cafes: '☕ قسم المقاهي والحلويات', groceries: '🥬 قسم البقالات', pharmacies: '💊 الصيدليات' };
            storeNameText = catNames[ad.catKey] || 'عروض فوري الحصرية';
          }
          combinedOffersList.push({
            type: 'ad',
            catKey: ad.catKey || 'restaurants',
            storeKey: ad.storeKey || '',
            headerLabel: storeNameText,
            title: ad.title,
            desc: ad.desc || '',
            image: ad.image || ''
          });
        }
      });

      Object.keys(storesData).forEach(sKey => {
        const st = storesData[sKey];
        const flash = st.flashSale && st.flashSale.active ? st.flashSale : null;
        if (flash && flash.targetItemIds && flash.targetItemIds.length > 0 && st.menu) {
          Object.keys(st.menu).forEach(catKey => {
            const cat = st.menu[catKey];
            if (cat && cat.items) {
              cat.items.forEach(item => {
                if (flash.targetItemIds.includes(String(item.id))) {
                  const discountedPrice = (item.price * (1 - flash.discount / 100)).toFixed(2);
                  combinedOffersList.push({
                    type: 'store_discount',
                    storeKey: sKey,
                    headerLabel: `🔥 عرض خاص من: ${st.name} (خصم ${flash.discount}%)`,
                    title: item.name,
                    desc: `${item.desc} | السعر بعد الخصم: ${discountedPrice} د.أ (بدلاً من ${item.price.toFixed(2)} د.أ)`,
                    image: item.image || ''
                  });
                }
              });
            }
          });
        }
      });

      if (combinedOffersList.length === 0) {
        combinedOffersList.push({
          type: 'default',
          catKey: 'restaurants',
          storeKey: '',
          headerLabel: '🍔 قسم المطاعم والمشويات',
          title: 'وجبة شاورما دجاج مع بطاطا ومخلل',
          desc: 'توصيل فوري وساخن خلال دقائق بخصم خاص!',
          image: ''
        });
      }

      currentOfferIndex = 0;
      renderCurrentFeaturedOffer();

      if (offersIntervalId) clearInterval(offersIntervalId);
      if (combinedOffersList.length > 1) {
        offersIntervalId = setInterval(() => {
          currentOfferIndex = (currentOfferIndex + 1) % combinedOffersList.length;
          renderCurrentFeaturedOffer();
        }, 4000);
      }
    }

    function renderCurrentFeaturedOffer() {
      if (combinedOffersList.length === 0) return;
      const offer = combinedOffersList[currentOfferIndex];
      const container = document.getElementById('featured-offer-content');

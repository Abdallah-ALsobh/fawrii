    function dismissSplashScreen() {
      if (isInitialized) return;
      isInitialized = true;
      const splash = document.getElementById('splash-screen-overlay');
      if (splash) {
        splash.style.opacity = '0';
        splash.style.visibility = 'hidden';
        setTimeout(() => splash.remove(), 700);

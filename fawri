    function exchangePointsForVoucher(requiredPoints, discountValue, voucherCode) {
      if ((currentUser.points || 0) < requiredPoints) { alert('رصيدك من النقاط غير كافٍ للحصول على هذه القسيمة!'); return; }
      currentUser.points -= requiredPoints;
      
      if (!currentUser.vouchers) currentUser.vouchers = [];
      if (!currentUser.vouchers.find(v => v.code === voucherCode)) {
        currentUser.vouchers.push({ code: voucherCode, discountValue: discountValue });
      }

      saveUserToDatabase();
      updateAuthUI();
      closeLoyaltyModal();
      alert(`🎉 مبروك! حصلت على قسيمة خصم بقيمة ${discountValue.toFixed(2)} د.أ (كود: ${voucherCode}) وتتطلب مشتريات بقيمة ${(discountValue * 6).toFixed(2)} د.أ فأكثر.`);
      openVouchersModal();
    }

    function addNewVoucherToAccount() {
      const code = document.getElementById('new-voucher-code').value.trim().toUpperCase();
      const val = parseFloat(document.getElementById('new-voucher-val').value);
      if (!code || isNaN(val) || val <= 0) { alert('الرجاء إدخال كود صحيح وقيمة مالية صالحة للقسيمة!'); return; }

      if (!currentUser.vouchers) currentUser.vouchers = [];
      if (currentUser.vouchers.find(v => v.code === code)) {
        alert('هذه القسيمة موجودة مسبقاً في حسابك!');
        return;
      }

      currentUser.vouchers.push({ code: code, discountValue: val });
      saveUserToDatabase();
      document.getElementById('new-voucher-code').value = '';
      document.getElementById('new-voucher-val').value = '';
      alert(`✅ تمت إضافة قسيمة الخصم (${code}) بقيمة ${val.toFixed(2)} د.أ إلى حسابك بنجاح!`);
      openVouchersModal();

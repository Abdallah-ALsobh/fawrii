    function filterHomeItems() {
      const query = document.getElementById('header-search-input').value.trim().toLowerCase();
      const searchSection = document.getElementById('search-results-section');
      const storesView = document.getElementById('stores-view');
      const categoryView = document.getElementById('category-page-view');
      const menuView = document.getElementById('menu-view');
      const grid = document.getElementById('search-results-grid');

      if (!query) {
        searchSection.classList.add('hidden');
        storesView.classList.remove('hidden');
        return;
      }

      storesView.classList.add('hidden');
      categoryView.classList.add('hidden');
      menuView.classList.add('hidden');
      searchSection.classList.remove('hidden');
      grid.innerHTML = '';

      let resultsCount = 0;

      Object.keys(storesData).forEach(sKey => {
        const st = storesData[sKey];
        let matchesStore = st.name.toLowerCase().includes(query) || st.subtitle.toLowerCase().includes(query);
        let matchedItems = [];

        if (st.menu) {
          Object.keys(st.menu).forEach(catKey => {
            const cat = st.menu[catKey];
            if (cat && cat.items) {
              cat.items.forEach(item => {
                if (item.name.toLowerCase().includes(query) || item.desc.toLowerCase().includes(query)) {
                  matchedItems.push(item);
                }
              });
            }
          });
        }

        if (matchesStore || matchedItems.length > 0) {
          resultsCount++;
          const div = document.createElement('div');
          div.className = 'store-icon-card cursor-pointer flex-col sm:flex-row items-start sm:items-center';
          div.onclick = () => openStore(sKey);
          
          let itemsPreview = matchedItems.length > 0 
            ? `<p class="text-[11px] text-[#881337] font-bold mt-1">منتجات مطابقة: ${matchedItems.map(i => i.name).join('، ')}</p>` 
            : '';

          div.innerHTML = `
            <img src="${st.image || 'https://images.unsplash.com/photo-1555396273-367ea4eb4db5'}" class="w-full sm:w-16 h-28 sm:h-16 object-cover rounded-xl border border-gray-100 shrink-0">
            <div class="flex-1 min-w-0 w-full mt-2 sm:mt-0">
              <div class="flex justify-between items-center">
                <h4 class="font-extrabold text-sm text-gray-900 truncate">${st.name}</h4>
                <span class="text-xs font-bold bg-amber-100 text-amber-800 px-2 py-0.5 rounded">⭐ 4.8</span>
              </div>
              <p class="text-xs text-gray-500 truncate mt-0.5">${st.subtitle}</p>
              ${itemsPreview}
              <span class="inline-block mt-2 text-[11px] font-extrabold text-[#881337]">دخول المنشأة وتصفح المنتجات <i class="fa-solid fa-arrow-left mr-1"></i></span>
            </div>
          `;
          grid.appendChild(div);
        }
      });

      if (resultsCount === 0) {
        grid.innerHTML = '<p class="col-span-full text-center text-gray-500 text-xs py-8 font-medium">عذراً، لم نجد أي نتائج مطابقة لبحثك.</p>';
      }
    }


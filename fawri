    function applyCartVoucher() {
      const codeInput = document.getElementById('cart-voucher-input').value.trim().toUpperCase();
      const errEl = document.getElementById('cart-voucher-error');
      if (!codeInput) { errEl.textContent = 'أدخل كود القسيمة'; errEl.classList.remove('hidden'); return; }

      let discountVal = 0;
      if (codeInput === 'FORI10') discountVal = 1.00;
      else if (codeInput === 'FORI25') discountVal = 2.50;
      else if (currentUser && currentUser.vouchers) {
        const found = currentUser.vouchers.find(v => v.code === codeInput);
        if (found) discountVal = found.discountValue;
      }

      if (discountVal === 0) {
        errEl.textContent = 'الكود غير صحيح أو غير متوفر في حسابك!';
        errEl.classList.remove('hidden');
        return;
      }

      const currentSubtotal = cart.reduce((sum, item) => sum + (item.basePrice * item.qty), 0);
      const minRequiredSpend = discountVal * 6;

      if (currentSubtotal < minRequiredSpend) {
        errEl.textContent = `عذراً! هذه القسيمة تتطلب حدا أدنى للمشتريات بقيمة ${minRequiredSpend.toFixed(2)} د.أ.`;
        errEl.classList.add('hidden');
        return;
      }

      errEl.classList.add('hidden');
      activateVoucher(codeInput, discountVal);
      document.getElementById('cart-voucher-input').value = '';
    }

    function activateVoucher(code, discountValue) {
      const currentSubtotal = cart.reduce((sum, item) => sum + (item.basePrice * item.qty), 0);
      const minRequiredSpend = discountValue * 6;

      if (currentSubtotal < minRequiredSpend) {
        alert(`عذراً! قسيمة الخصم (${code}) تتطلب حدا أدنى للمشتريات بقيمة ${minRequiredSpend.toFixed(2)} د.أ.`);
        return;
      }

      appliedVoucher = { code, discountValue };
      renderCart();
      alert(`✅ تم تفعيل قسيمة الخصم (${code}) بنجاح!`);
    }

